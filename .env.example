# Development-only Compose configuration. Copy to .env and do not commit .env.
POSTGRES_DB=license_server
POSTGRES_USER=license_app
# Replace both example passwords before starting Compose.
POSTGRES_PASSWORD=local-db-password-change-me

SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_EMAIL=admin@localhost.com
DEFAULT_ADMIN_PASSWORD=LocalAdmin!7Kp9-Vx3-Rm8-Qz2
SEED_DEMO_LICENSE=true
# IANA business timezone used only for the date embedded in generated license IDs.
LICENSE_ID_TIME_ZONE=Australia/Adelaide
# Generate with: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# This example is intentionally not a usable secret; place the generated value only in .env or a secret manager.
# openssl rand -base64 32
ACTIVATION_CODE_PEPPER=replace-with-32-random-bytes-as-base64
# Generate independently from ACTIVATION_CODE_PEPPER; never reuse peppers between credential classes.
# openssl rand -base64 32
API_CREDENTIAL_PEPPER=replace-with-another-32-random-bytes-as-base64
# Generate independently from the other peppers; never reuse peppers between credential classes.
# openssl rand -base64 32
DEPLOYMENT_KEY_PEPPER=replace-with-yet-another-32-random-bytes-as-base64
# MailerSend credentials stay in .env or a production secret manager. The webhook secret
# is the signing key configured for the MailerSend delivery-status webhook.
# openssl rand -hex 24
MAILERSEND_API_TOKEN=replace-with-mailersend-api-token
MAILERSEND_FROM_EMAIL=licenses@example.com
MAILERSEND_FROM_NAME=License Server
MAILERSEND_WEBHOOK_SECRET=replace-with-mailersend-webhook-signing-secret
# Stripe credentials stay in .env or a production secret manager. Prefer a restricted
# API key with only the read permissions required for billing reconciliation.
STRIPE_API_KEY=replace-with-restricted-stripe-api-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-endpoint-secret
# Explicit licensing policy. Refund/dispute values are review or suspend.
BILLING_GRACE_PERIOD_DAYS=7
BILLING_REFUND_ACTION=review
BILLING_DISPUTE_ACTION=review
# Public HTTPS origin used to build customer magic links in email.
CUSTOMER_PORTAL_PUBLIC_BASE_URL=https://licenses.example.com
# One-time local recovery switch. Set true for one start, then immediately restore false.
RESET_ADMIN_PASSWORD=false

APP_PORT=8080
# Host path to the key-ring directory; Compose mounts it read-only at
# /var/lib/licenseserver/keys. Populate it with "<keyId>.private.pem" /
# "<keyId>.public.pem" pairs (see keys/ for the PoC's primary-2026/secondary-2026 pair).
LICENSE_SIGNING_KEY_DIR=./keys
# keyId of the SigningKeys row seeded as the initial default the first time the
# database has none marked default. Ignored afterward: rotate the live default via
# the admin UI's "Set as default" action instead, not by changing this value.
LICENSE_DEFAULT_SIGNING_KEY=primary-2026
