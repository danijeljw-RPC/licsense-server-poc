# Development-only Compose configuration. Copy to .env and do not commit .env.
POSTGRES_DB=license_server
POSTGRES_USER=license_app
# Replace both example passwords before starting Compose.
POSTGRES_PASSWORD=local-db-password-change-me

SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_EMAIL=admin@localhost.com
DEFAULT_ADMIN_PASSWORD=LocalAdmin!7Kp9-Vx3-Rm8-Qz2
SEED_DEMO_LICENSE=true
# One-time local recovery switch. Set true for one start, then immediately restore false.
RESET_ADMIN_PASSWORD=false

APP_PORT=8080
# Absolute host path to the existing PoC private key; Compose mounts it read-only.
LICENSE_SIGNING_KEY_PATH=./keys/license-primary-2026-private.pem
