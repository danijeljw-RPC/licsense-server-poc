@inherits LayoutComponentBase

<div class="shell">
    <aside class="sidebar">
        <a class="brand" href="/">License<span>Desk</span></a>
        <NavMenu />
    </aside>
    <main>
        <header class="topbar">
            <div><strong>License operations</strong><small>Secure administration console</small></div>
            <AuthorizeView>
                <Authorized Context="auth">
                    <span class="user">@auth.User.Identity?.Name</span>
                    <a href="/Account/Manage">Security</a>
                    <form action="/Account/Logout" method="post"><AntiforgeryToken /><input type="hidden" name="returnUrl" value="" /><button class="link-button" type="submit">Sign out</button></form>
                </Authorized>
                <NotAuthorized><a href="/Account/Login">Sign in</a></NotAuthorized>
            </AuthorizeView>
        </header>
        <section class="content">@Body</section>
    </main>
</div>
