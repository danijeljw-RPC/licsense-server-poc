@page "/"
@attribute [Authorize(Policy = Permissions.LicensesRead)]
@inject AdminDataService Data

<PageTitle>Dashboard</PageTitle>
<div class="page-heading"><div><p class="eyebrow">Command centre</p><h1>Licensing overview</h1><p>Current state across issued licenses and activations.</p></div><a class="button" href="/licenses/create">Issue license</a></div>

@if (dashboard is null) { <p class="loading">Loading operational data…</p> }
else
{
    <div class="metric-grid">
        <article class="metric primary"><span>Total licenses</span><strong>@dashboard.Total</strong><small>All issued records</small></article>
        <article class="metric"><span>Available</span><strong>@dashboard.Available</strong><small>Ready to activate</small></article>
        <article class="metric"><span>Active</span><strong>@dashboard.Active</strong><small>Bound to a device</small></article>
        <article class="metric warning"><span>Expired</span><strong>@dashboard.Expired</strong><small>Past license expiry</small></article>
        <article class="metric danger"><span>Revoked</span><strong>@dashboard.Revoked</strong><small>Administratively blocked</small></article>
    </div>
    <div class="split-grid">
        <article class="panel"><div class="panel-head"><div><p class="eyebrow">Activation posture</p><h2>Connected devices</h2></div></div>
            <div class="activation-summary"><div><strong>@dashboard.Online</strong><span>Online</span></div><div><strong>@dashboard.Offline</strong><span>Offline</span></div><div><strong>@dashboard.LeasesApproachingExpiry</strong><span>Lease expiry ≤ 48h</span></div></div>
            <p class="notice">Offline licenses remain locally valid until the client reconnects or the signed license expires. Revocation is therefore weaker than for online leases.</p>
        </article>
        <article class="panel"><div class="panel-head"><div><p class="eyebrow">Latest activity</p><h2>Audit events</h2></div><a href="/audit">View all</a></div>
            <div class="event-list">@foreach (var item in dashboard.RecentAudit) { <div><span class="status @item.Result">@item.Result</span><p><strong>@item.Action</strong><small>@item.Actor · @item.TimestampUtc.ToString("u") UTC</small></p></div> }</div>
        </article>
    </div>
}

@code { private DashboardView? dashboard; protected override async Task OnInitializedAsync() => dashboard = await Data.GetDashboardAsync(); }
