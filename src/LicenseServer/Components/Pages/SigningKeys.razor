@page "/settings/signing-keys"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Permissions.LicensesRead)]
@inject SigningKeyRingService KeyRing
@inject AuthenticationStateProvider AuthenticationState

<PageTitle>Signing keys</PageTitle>
<div class="page-heading"><div><p class="eyebrow">Key ring</p><h1>Signing keys</h1><p>Keys are discovered by dropping <code>&lt;keyId&gt;.private.pem</code> / <code>&lt;keyId&gt;.public.pem</code> into the mounted key directory; this page reflects the live key ring, backed by the <code>SigningKeys</code> table.</p></div></div>
@if (message is not null) { <div class="alert @(isError ? "error" : "success")" role="status">@message</div> }
@if (KeyRing.DefaultKeyId is null) { <div class="alert error" role="alert"><strong>No default signing key is configured.</strong> Issuance will fail until an administrator sets one below.</div> }

<article class="panel"><div class="panel-head"><div><h2>Key ring</h2></div><AuthorizeView Policy="@Permissions.SigningKeysManage"><Authorized><button class="button secondary" @onclick="RescanAsync">Rescan key directory</button></Authorized></AuthorizeView></div>
<div class="table-wrap"><table><thead><tr><th>Key ID</th><th>Status</th><th>Algorithm</th><th>Default</th><th>Discovered</th><th>Last seen</th><th></th></tr></thead><tbody>
@if (keys.Count == 0) { <tr><td colspan="7">No signing keys have been discovered yet.</td></tr> }
@foreach (var key in keys)
{
    <tr>
        <td><code>@key.KeyId</code></td>
        <td><span class="status @StatusClass(key.Status)">@key.Status</span>@if (key.Status == SigningKeyStatus.Revoked && key.RevocationReason is not null) { <div class="context">@key.RevocationReason</div> }</td>
        <td>@key.Algorithm</td>
        <td>@(key.IsDefault ? "Yes" : "—")</td>
        <td>@key.DiscoveredAt.ToString("u")</td>
        <td>@key.LastSeenAt.ToString("u")</td>
        <td>
            <AuthorizeView Policy="@Permissions.SigningKeysManage">
                <Authorized>
                    @if (key.CanSign && !key.IsDefault) { <button class="button secondary" @onclick="() => SetDefaultAsync(key)">Set as default</button> }
                    @if (key.Status != SigningKeyStatus.Revoked) { <button class="button danger" @onclick="() => BeginRevoke(key)">Revoke</button> }
                </Authorized>
            </AuthorizeView>
        </td>
    </tr>
}
</tbody></table></div>
</article>

<AuthorizeView Policy="@Permissions.SigningKeysManage">
<Authorized Context="manageAuthContext">
@if (revokeTarget is not null)
{
    <article class="panel danger-zone"><h2>Revoke @revokeTarget.KeyId</h2><p>Revocation is destructive and immediate: every license this key ever signed will fail verification inside this server (not inside already-shipped products embedding <code>LicenseValidator</code>). Retirement (removing only the private key file) is the reversible alternative that keeps historical verification working — prefer it unless the key is actually compromised.</p>
        <EditForm Model="revokeForm" FormName="revoke-signing-key" OnValidSubmit="ConfirmRevokeAsync"><DataAnnotationsValidator /><label>Required reason<InputTextArea @bind-Value="revokeForm.Reason" minlength="3" maxlength="500" /></label><label class="confirm"><InputCheckbox @bind-Value="revokeForm.Confirmed" /> I explicitly confirm revocation of <code>@revokeTarget.KeyId</code>.</label><div class="split-grid"><button class="button danger" type="submit">Confirm revocation</button><button class="button secondary" type="button" @onclick="CancelRevoke">Cancel</button></div></EditForm>
    </article>
}
<article class="panel"><h2>Add or retire a key</h2><p class="field-help">This POC's key ring is disk-backed by design: private key material is never accepted through a web form or stored in the database (only the public key and lifecycle metadata are). To <strong>add</strong> a key, generate an ECDSA P-256 pair named <code>&lt;keyId&gt;.private.pem</code> / <code>&lt;keyId&gt;.public.pem</code> and drop both files into the server's configured key directory, then rescan (or wait for the next periodic reload). To <strong>retire</strong> a key from signing while keeping it able to verify historical licenses, remove only its <code>.private.pem</code> file and rescan — the key ring detects this automatically and stamps <code>RetiredAt</code>. Use <strong>Revoke</strong> above only for a genuinely compromised key.</p></article>
</Authorized>
</AuthorizeView>

@code {
    private IReadOnlyList<SigningKeyInfo> keys = [];
    private string? message;
    private bool isError;
    private SigningKeyInfo? revokeTarget;
    private readonly RevokeForm revokeForm = new();

    protected override void OnInitialized() => Reload();
    private void Reload() => keys = KeyRing.Keys.OrderByDescending(k => k.IsDefault).ThenBy(k => k.KeyId, StringComparer.Ordinal).ToList();

    private static string StatusClass(SigningKeyStatus status) => status switch
    {
        SigningKeyStatus.Active => "active",
        SigningKeyStatus.VerificationOnly => "available",
        SigningKeyStatus.Revoked => "revoked",
        _ => "expired"
    };

    private async Task<string> ActorAsync() => (await AuthenticationState.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";

    private async Task RescanAsync() => await ExecuteAsync(async () => { await KeyRing.ReloadAsync(); message = "Key directory rescanned."; });

    private async Task SetDefaultAsync(SigningKeyInfo key) => await ExecuteAsync(async () =>
    {
        await KeyRing.SetDefaultAsync(key.KeyId, await ActorAsync());
        message = $"'{key.KeyId}' is now the default signing key.";
    });

    private void BeginRevoke(SigningKeyInfo key) { revokeTarget = key; revokeForm.Reason = ""; revokeForm.Confirmed = false; message = null; }
    private void CancelRevoke() => revokeTarget = null;

    private async Task ConfirmRevokeAsync() => await ExecuteAsync(async () =>
    {
        if (revokeTarget is null) return;
        await KeyRing.RevokeAsync(revokeTarget.KeyId, revokeForm.Reason, await ActorAsync());
        message = $"'{revokeTarget.KeyId}' has been revoked.";
        revokeTarget = null;
    });

    private async Task ExecuteAsync(Func<Task> action)
    {
        message = null; isError = false;
        try { await action(); }
        catch (InvalidOperationException exception) { message = exception.Message; isError = true; }
        Reload();
    }

    private sealed class RevokeForm
    {
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.MinLength(3), System.ComponentModel.DataAnnotations.MaxLength(500)]
        public string Reason { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Range(typeof(bool), "true", "true", ErrorMessage = "Revocation requires explicit confirmation.")]
        public bool Confirmed { get; set; }
    }
}
