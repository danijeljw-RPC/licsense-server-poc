@page "/settings/stripe-product-mappings"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Permissions.BillingManage)]
@inject StripeProductMappingService Mappings
@inject ProductCatalogService Catalog
@inject AuthenticationStateProvider AuthenticationState

<PageTitle>Stripe product mappings</PageTitle>
<div class="page-heading"><div><p class="eyebrow">Billing</p><h1>Stripe product mappings</h1><p>Map Stripe product IDs to license terms. Rows with edition, license type, and seats filled in are used for one-time (non-subscription) checkout purchases; rows left blank are used only to resolve the product for subscription checkouts.</p></div></div>

@if (message is not null) { <div class="alert @(isError ? "error" : "success")" role="status">@message</div> }

<form method="get" class="filters"><label>Search<input name="search" value="@Search" placeholder="Stripe product ID or product code" /></label><button class="button secondary" type="submit">Search</button></form>

<article class="panel form-panel"><h2>Add mapping</h2>
    <EditForm Model="create" FormName="create-stripe-product-mapping" OnValidSubmit="CreateAsync"><DataAnnotationsValidator /><ValidationSummary />
        <div class="form-grid">
            <label>Stripe product ID<InputText @bind-Value="create.StripeProductId" placeholder="prod_..." /></label>
            <label>Product<InputSelect @bind-Value="create.ProductDefinitionId">
                <option value="">Select a product</option>
                @foreach (var product in products) { <option value="@product.Id">@product.Code — @product.DisplayName</option> }
            </InputSelect></label>
            <label>Edition<InputSelect @bind-Value="create.Edition">
                <option value="">(leave blank for subscription-only mapping)</option>
                @foreach (var edition in LicenseEditions.All) { <option value="@edition">@edition</option> }
            </InputSelect></label>
            <label>License type<InputSelect @bind-Value="create.LicenseType">
                <option value="">(leave blank for subscription-only mapping)</option>
                <option value="perpetual">perpetual</option>
                <option value="subscription">subscription</option>
                <option value="evaluation">evaluation</option>
            </InputSelect></label>
            <label>Seats<InputNumber @bind-Value="create.Seats" /></label>
            <label>Updates until<InputDate @bind-Value="create.UpdatesUntil" /></label>
            <label>Expires at (blank = perpetual)<InputDate @bind-Value="create.ExpiresAt" /></label>
        </div>
        <button class="button" type="submit">Add mapping</button>
    </EditForm>
</article>

<div class="table-wrap"><table><thead><tr><th>Stripe product ID</th><th>Product</th><th>Edition</th><th>License type</th><th>Seats</th><th>Updates until</th><th>Expires at</th><th></th></tr></thead><tbody>
@foreach (var mapping in mappings)
{
    <tr>
        <td><code>@mapping.StripeProductId</code></td>
        <td><strong>@mapping.ProductCode</strong><br />@mapping.ProductDisplayName</td>
        <td>@(mapping.Edition ?? "—")</td>
        <td>@(mapping.LicenseType ?? "—")</td>
        <td>@(mapping.Seats?.ToString() ?? "—")</td>
        <td>@(mapping.UpdatesUntil?.ToString("yyyy-MM-dd") ?? "—")</td>
        <td>@(mapping.ExpiresAt?.ToString("u") ?? "never")</td>
        <td>
            <button class="button secondary" type="button" @onclick="() => Select(mapping)">Edit</button>
            <button class="button danger" type="button" @onclick="() => DeleteAsync(mapping)">Delete</button>
        </td>
    </tr>
}
</tbody></table></div>

@if (selected is not null)
{
    <article class="panel form-panel"><h2>Edit @selected.StripeProductId</h2><p>The Stripe product ID cannot be changed.</p>
        <EditForm Model="edit" FormName="edit-stripe-product-mapping" OnValidSubmit="UpdateAsync"><DataAnnotationsValidator /><ValidationSummary />
            <div class="form-grid">
                <label>Product<InputSelect @bind-Value="edit.ProductDefinitionId">
                    @foreach (var product in products) { <option value="@product.Id">@product.Code — @product.DisplayName</option> }
                </InputSelect></label>
                <label>Edition<InputSelect @bind-Value="edit.Edition">
                    <option value="">(leave blank for subscription-only mapping)</option>
                    @foreach (var edition in LicenseEditions.All) { <option value="@edition">@edition</option> }
                </InputSelect></label>
                <label>License type<InputSelect @bind-Value="edit.LicenseType">
                    <option value="">(leave blank for subscription-only mapping)</option>
                    <option value="perpetual">perpetual</option>
                    <option value="subscription">subscription</option>
                    <option value="evaluation">evaluation</option>
                </InputSelect></label>
                <label>Seats<InputNumber @bind-Value="edit.Seats" /></label>
                <label>Updates until<InputDate @bind-Value="edit.UpdatesUntil" /></label>
                <label>Expires at (blank = perpetual)<InputDate @bind-Value="edit.ExpiresAt" /></label>
            </div>
            <button class="button" type="submit">Save mapping</button>
        </EditForm>
    </article>
}

@code {
    [SupplyParameterFromQuery] public string? Search { get; set; }
    private IReadOnlyList<StripeProductMappingItem> mappings = [];
    private IReadOnlyList<ProductCatalogItem> products = [];
    private StripeProductMappingItem? selected;
    private readonly MappingForm create = new();
    private readonly MappingForm edit = new();
    private string? message;
    private bool isError;

    protected override async Task OnParametersSetAsync()
    {
        products = await Catalog.ActiveAsync();
        mappings = await Mappings.SearchAsync(Search);
    }

    private async Task<string> ActorAsync() =>
        (await AuthenticationState.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";

    private async Task CreateAsync() => await ExecuteAsync(async () =>
    {
        await Mappings.CreateAsync(new CreateStripeProductMappingRequest(
            create.StripeProductId, string.IsNullOrEmpty(create.ProductDefinitionId) ? null : Guid.Parse(create.ProductDefinitionId),
            string.IsNullOrWhiteSpace(create.Edition) ? null : create.Edition,
            string.IsNullOrWhiteSpace(create.LicenseType) ? null : create.LicenseType,
            create.Seats, create.UpdatesUntil is null ? null : DateOnly.FromDateTime(create.UpdatesUntil.Value), create.ExpiresAt),
            await ActorAsync());
        create.StripeProductId = ""; create.ProductDefinitionId = ""; create.Edition = ""; create.LicenseType = "";
        create.Seats = null; create.UpdatesUntil = null; create.ExpiresAt = null;
        message = "Mapping created.";
    });

    private void Select(StripeProductMappingItem mapping)
    {
        selected = mapping;
        edit.ProductDefinitionId = mapping.ProductDefinitionId.ToString();
        edit.Edition = mapping.Edition ?? "";
        edit.LicenseType = mapping.LicenseType ?? "";
        edit.Seats = mapping.Seats;
        edit.UpdatesUntil = mapping.UpdatesUntil?.ToDateTime(TimeOnly.MinValue);
        edit.ExpiresAt = mapping.ExpiresAt;
    }

    private async Task UpdateAsync() => await ExecuteAsync(async () =>
    {
        if (selected is null) return;
        await Mappings.UpdateAsync(selected.Id, new UpdateStripeProductMappingRequest(
            string.IsNullOrEmpty(edit.ProductDefinitionId) ? null : Guid.Parse(edit.ProductDefinitionId),
            string.IsNullOrWhiteSpace(edit.Edition) ? null : edit.Edition,
            string.IsNullOrWhiteSpace(edit.LicenseType) ? null : edit.LicenseType,
            edit.Seats, edit.UpdatesUntil is null ? null : DateOnly.FromDateTime(edit.UpdatesUntil.Value), edit.ExpiresAt),
            await ActorAsync());
        message = "Mapping updated.";
        selected = null;
    });

    private async Task DeleteAsync(StripeProductMappingItem mapping) => await ExecuteAsync(async () =>
    {
        await Mappings.DeleteAsync(mapping.Id, await ActorAsync());
        message = "Mapping deleted.";
    });

    private async Task ExecuteAsync(Func<Task> action)
    {
        message = null; isError = false;
        try { await action(); }
        catch (InvalidOperationException exception) { message = exception.Message; isError = true; }
        mappings = await Mappings.SearchAsync(Search);
    }

    private sealed class MappingForm
    {
        public string StripeProductId { get; set; } = "";
        public string ProductDefinitionId { get; set; } = "";
        public string Edition { get; set; } = "";
        public string LicenseType { get; set; } = "";
        public int? Seats { get; set; }
        public DateTime? UpdatesUntil { get; set; }
        public DateTimeOffset? ExpiresAt { get; set; }
    }
}
