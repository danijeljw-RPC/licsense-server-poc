@page "/licenses/import"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Permissions.LicensesImport)]
@implements IAsyncDisposable
@inject LicenseImportService Importer
@inject AuthenticationStateProvider AuthenticationState

<PageTitle>Import license</PageTitle>
<div class="page-heading"><div><p class="eyebrow">Offline artifact</p><h1>Import a signed license</h1><p>Upload a license file produced by <code>LicenseGenerator</code> (or another offline signer) and index it into this server.</p></div></div>
<div class="alert warning"><strong>Verbatim storage, not re-issuance:</strong> the uploaded file is verified against the live signing key ring and stored byte-for-byte. It is never re-signed or regenerated. A product named in the artifact that this catalog does not recognize is auto-created as inactive and needs operator review before it can be sold against.</div>
@if (error is not null) { <div class="alert error" role="alert">@error</div> }
@if (result is null)
{
    <article class="panel form-panel">
        <EditForm Model="form" FormName="import-license" OnValidSubmit="ImportAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <label>License artifact<InputFile @key="fileInputKey" OnChange="OnFileSelected" accept=".license,application/json" disabled="@isSubmitting" /></label>
            @if (selectedFile is not null) { <p class="field-help">Selected: @selectedFile.Name (@FormatSize(selectedFile.Size))</p> }
            <p class="field-help">Up to 256 KB. Anything larger is rejected before it is read.</p>
            <label>Contact email<InputText type="email" @bind-Value="form.ContactEmail" autocomplete="off" disabled="@isSubmitting" /></label>
            <p class="field-help">The resolved customer record uses this address. If the artifact's own signed metadata also carries a <code>contactEmail</code>, the two must match exactly or the import is rejected.</p>
            <button class="button" type="submit" disabled="@isSubmitting" aria-disabled="@isSubmitting">@(isSubmitting ? "Importing…" : "Verify and import")</button>
        </EditForm>
    </article>
}
else
{
    <article class="panel form-panel" aria-labelledby="import-result-heading">
        <p class="eyebrow">Imported successfully</p>
        <h2 id="import-result-heading">@result.LicenseId</h2>
        <dl><dt>Products</dt><dd>@string.Join(", ", result.Products)</dd></dl>
        @if (result.AutoCreatedProducts.Count > 0)
        {
            <div class="alert warning" role="status">
                <strong>@result.AutoCreatedProducts.Count product@(result.AutoCreatedProducts.Count == 1 ? "" : "s") auto-created as inactive and need review before they can be sold against:</strong>
                <ul>@foreach (var productCode in result.AutoCreatedProducts) { <li><code>@productCode</code> · <a href="@($"/products?search={Uri.EscapeDataString(productCode)}")">review in catalog →</a></li> }</ul>
            </div>
        }
        <p><a class="button" href="@($"/licenses/{Uri.EscapeDataString(result.LicenseId)}")">View license →</a> <button class="button secondary" type="button" @onclick="Reset">Import another</button></p>
    </article>
}

@code {
    private readonly ImportForm form = new();
    private IBrowserFile? selectedFile;
    private Guid fileInputKey = Guid.NewGuid();
    private string? error;
    private bool isSubmitting;
    private ImportedLicense? result;
    private CancellationTokenSource? cts;

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        // Advisory only, using the browser-reported size: the authoritative limit is enforced
        // server-side by OpenReadStream(maxAllowedSize:) below, which never trusts this value.
        error = selectedFile.Size > LicenseImportService.MaxUploadBytes
            ? $"'{selectedFile.Name}' is {FormatSize(selectedFile.Size)}, which exceeds the 256 KB import limit."
            : null;
    }

    private async Task ImportAsync()
    {
        if (isSubmitting) return;
        if (selectedFile is null) { error = "A license file is required."; return; }

        isSubmitting = true;
        error = null;
        cts = new CancellationTokenSource();
        try
        {
            byte[] bytes;
            try
            {
                await using var stream = selectedFile.OpenReadStream(LicenseImportService.MaxUploadBytes, cts.Token);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer, cts.Token);
                bytes = buffer.ToArray();
            }
            catch (IOException)
            {
                error = "The selected file exceeds the 256 KB import limit.";
                return;
            }

            var actor = (await AuthenticationState.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";
            var outcome = await Importer.ImportAsync(bytes, selectedFile.Name, form.ContactEmail, actor, cts.Token);
            if (!outcome.Success)
            {
                error = outcome.Error;
                return;
            }

            result = outcome.Value;
            selectedFile = null;
            fileInputKey = Guid.NewGuid();
            form.ContactEmail = "";
        }
        catch (UnauthorizedAccessException)
        {
            error = "You do not have permission to import licenses.";
        }
        catch (OperationCanceledException)
        {
            // Component was disposed (navigation away) mid-upload; nothing left to report to.
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Reset()
    {
        result = null;
        error = null;
        selectedFile = null;
        fileInputKey = Guid.NewGuid();
    }

    private static string FormatSize(long bytes) => bytes < 1024 ? $"{bytes} B" : $"{bytes / 1024.0:F1} KB";

    public async ValueTask DisposeAsync()
    {
        if (cts is not null)
        {
            await cts.CancelAsync();
            cts.Dispose();
        }
    }

    private sealed class ImportForm
    {
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.EmailAddress]
        public string ContactEmail { get; set; } = "";
    }
}
