@page "/licenses/create"
@attribute [Authorize(Policy = "Administrator")]
@inject AdminDataService Data
@inject NavigationManager Navigation

<PageTitle>Issue license</PageTitle><div class="page-heading"><div><p class="eyebrow">Issuance</p><h1>Create a license</h1><p>Define the customer, entitlement, and activation credential.</p></div></div>
@if (error is not null) { <div class="alert error">@error</div> }
<article class="panel form-panel"><EditForm Model="Input" FormName="create-license" OnValidSubmit="CreateAsync" method="post"><DataAnnotationsValidator /><ValidationSummary />
    <div class="form-grid"><label>License ID<InputText @bind-Value="Input.LicenseId" placeholder="LIC-2026-0002" /></label><label>Customer<InputText @bind-Value="Input.CustomerName" /></label><label>Product<InputText @bind-Value="Input.Product" /></label><label>Edition<InputText @bind-Value="Input.Edition" /></label><label>License type<InputSelect @bind-Value="Input.LicenseType"><option value="perpetual">Perpetual</option><option value="subscription">Subscription</option><option value="evaluation">Evaluation</option></InputSelect></label><label>Seats<InputNumber @bind-Value="Input.Seats" /></label><label>Activation code<InputText type="password" @bind-Value="Input.ActivationCode" autocomplete="new-password" /></label></div>
    <p class="notice">The activation code is immediately SHA-256 hashed. It is never stored or displayed in plaintext; deliver it to the customer through a separate secure channel.</p><button class="button" type="submit">Issue license</button>
</EditForm></article>
@code { [SupplyParameterFromForm] private CreateLicenseInput Input { get; set; } = default!; [CascadingParameter] private HttpContext HttpContext { get; set; } = default!; private string? error; protected override void OnInitialized() => Input ??= new(); private async Task CreateAsync() { try { var id = await Data.CreateLicenseAsync(Input, HttpContext.User.Identity?.Name ?? "unknown"); Navigation.NavigateTo($"/licenses/{Uri.EscapeDataString(id)}"); } catch (InvalidOperationException ex) { error = ex.Message; } } }
