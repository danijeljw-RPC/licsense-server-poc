@page "/licenses/create"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "licenses.issue")]
@implements IAsyncDisposable
@inject AdminDataService Data
@inject ProductCatalogService Products
@inject AuthenticationStateProvider AuthenticationState
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Issue license</PageTitle>
<div class="page-heading">
    <div>
        <p class="eyebrow">Issuance</p>
        <h1>Create a license</h1>
        <p>Define the customer and entitlement. The server creates both identifiers.</p>
    </div>
</div>

@if (error is not null)
{
    <div class="alert error" role="alert">@error</div>
}

@if (issued is not null)
{
    <article class="panel form-panel issuance-result" aria-labelledby="issuance-result-heading">
        <p class="eyebrow">Issued successfully</p>
        <h2 id="issuance-result-heading">Save the activation code now</h2>
        <p class="alert warning"><strong>This code is shown only on this screen.</strong> It cannot be recovered after you navigate away.</p>
        <div class="form-grid">
            <label>License ID<input value="@issued.LicenseId" readonly /></label>
            <label for="activation-code-result">Activation code</label>
            <div class="copy-field">
                <input id="activation-code-result" value="@issued.ActivationCode" readonly autocomplete="off" aria-describedby="copy-status" />
                <button class="button" type="button" @onclick="CopyActivationCodeAsync" aria-describedby="copy-status">Copy activation code</button>
            </div>
        </div>
        <p id="copy-status" class="copy-status" role="status" aria-live="polite">@copyStatus</p>
        <p><a class="button secondary" href="@($"/licenses/{Uri.EscapeDataString(issued.LicenseId)}")">Continue to license details</a></p>
    </article>
}
else
{
    <article class="panel form-panel">
        <EditForm Model="Input" FormName="create-license" OnValidSubmit="CreateAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="form-grid">
                <label>License ID<input value="Generated on issue" readonly /></label>
                <label>Customer<input @bind="Input.CustomerName" @bind:event="oninput" /></label>
                <label>Customer email<input type="email" @bind="Input.CustomerEmail" @bind:event="oninput" /></label>
                <label>Product<InputSelect @bind-Value="Input.ProductId"><option value="">Select an active product</option>@foreach (var product in products) { <option value="@product.Id">@product.DisplayName (@product.Code)</option> }</InputSelect></label>
                <label>Edition<InputSelect @bind-Value="Input.Edition">@foreach (var edition in LicenseEditions.All) { <option value="@edition">@edition</option> }</InputSelect></label>
                <label>License type<InputSelect @bind-Value="Input.LicenseType">@foreach (var licenseType in LicenseTerms.All) { <option value="@licenseType">@licenseType</option> }</InputSelect></label>
                <label>Expiry (required for subscription/evaluation)<InputDate Type="InputDateType.DateTimeLocal" @bind-Value="Input.ExpiresAt" /></label>
                <label>Seats<InputNumber @bind-Value="Input.Seats" /></label>
            </div>
            <p class="notice">The normalized customer email is embedded as plaintext signed metadata and is visible to anyone holding the license file. Never enter billing data, secrets, or provider objects. No activation code is accepted from the browser; the server generates it and stores only a versioned hash.</p>
            <button class="button" type="submit" disabled="@isSubmitting" aria-disabled="@isSubmitting">
                @(isSubmitting ? "Issuing…" : "Issue license")
            </button>
        </EditForm>
    </article>
}

@code
{
    private CreateLicenseInput Input { get; set; } = new();
    private string? error;
    private string? copyStatus;
    private bool isSubmitting;
    private string idempotencyToken = "";
    private LicenseStore.IssuedLicense? issued;
    private IReadOnlyList<ProductCatalogItem> products = [];
    private IJSObjectReference? module;

    protected override async Task OnInitializedAsync()
    {
        idempotencyToken = Convert.ToHexString(System.Security.Cryptography.RandomNumberGenerator.GetBytes(32));
        Navigation.LocationChanged += HandleLocationChanged;
        products = await Products.ActiveAsync();
        Input.ProductId = products.FirstOrDefault()?.Id;
    }

    private async Task CreateAsync()
    {
        if (isSubmitting) return;
        isSubmitting = true;
        error = null;
        try
        {
            var user = (await AuthenticationState.GetAuthenticationStateAsync()).User;
            var actor = user.Identity?.Name ?? "unknown";
            var principalId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? actor;
            issued = await Data.CreateLicenseAsync(Input, actor, principalId, idempotencyToken);
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task CopyActivationCodeAsync()
    {
        if (issued is null) return;
        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/CreateLicense.razor.js");
            await module.InvokeVoidAsync("copyText", issued.ActivationCode);
            copyStatus = "Activation code copied to the clipboard.";
        }
        catch (JSException)
        {
            copyStatus = "Copy failed. Select the activation code and copy it manually before leaving this page.";
        }
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        issued = null;
        copyStatus = null;
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        issued = null;
        if (module is not null)
        {
            try { await module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
