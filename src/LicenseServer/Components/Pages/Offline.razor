@page "/offline"
@attribute [Authorize(Policy = "Administrator")]
@using System.Text.Json
@inject LicenseStore Store
@inject LicenseEnvelopeSigner Signer

<PageTitle>Offline issuance</PageTitle>
<div class="page-heading"><div><p class="eyebrow">Air-gapped workflow</p><h1>Issue an offline activation</h1><p>Import a request created on the target device and return a signed <code>.license</code> file.</p></div></div>
<div class="alert warning"><strong>Weaker revocation guarantee:</strong> an offline license cannot learn about server-side revocation until the device reconnects. Use short expiries or online leases where timely revocation matters.</div>
@if (error is not null) { <div class="alert error" role="alert">@error</div> }
@if (download is not null) { <div class="alert success" role="status">Signed license issued. <a download="@fileName" href="@download">Download @fileName</a>. The imported request and full device ID are no longer displayed.</div> }
<article class="panel form-panel"><EditForm Model="form" FormName="offline-request" OnValidSubmit="IssueAsync" method="post"><DataAnnotationsValidator /><label>License ID<InputText @bind-Value="form.LicenseId" placeholder="LIC-YYYY-MMDDXXXXXX" /></label><label>Offline activation request JSON<InputTextArea class="code-input" @bind-Value="form.RequestJson" placeholder='{"requestId":"…","activationCode":"…","activationToken":"…","mode":"offline","device":{"scheme":"os-machine-id-sha256-v1","deviceId":"…"}}' /></label><p class="field-help">Activation tokens and full device identifiers are accepted only for issuance and are never rendered back to the page or written to logs.</p><button class="button" type="submit">Verify request and issue file</button></EditForm></article>
<article class="panel"><h2>Offline exchange</h2><ol class="steps"><li>Create the request on the target device with <code>scripts/New-OfflineActivationRequest.ps1</code>.</li><li>Move only that request to this trusted administration workstation.</li><li>Import it above and download the signed response.</li><li>Move the <code>.license</code> response back and validate it locally.</li></ol></article>
@code {
    private readonly OfflineForm form = new(); private string? error; private string? download; private string fileName = "activation.license";
    private async Task IssueAsync() { error = null; download = null; try { var request = JsonSerializer.Deserialize<ActivateRequest>(form.RequestJson, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? throw new JsonException(); if (request.Mode != "offline") { error = "The imported request must specify offline mode."; return; } var result = await Store.ActivateAsync(form.LicenseId, request, DateTimeOffset.UtcNow); if (!result.Success) { error = result.Error; return; } var signed = Signer.Sign(await Store.CreateLicenseAsync(result.Value!, DateTimeOffset.UtcNow)).ToJsonString(new JsonSerializerOptions { WriteIndented = true }); fileName = $"{form.LicenseId}-{result.Value!.ActivationId}.license"; download = $"data:application/octet-stream;base64,{Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(signed))}"; form.RequestJson = ""; } catch (JsonException) { error = "The activation request is not valid JSON."; } }
    private sealed class OfflineForm { [System.ComponentModel.DataAnnotations.Required] public string LicenseId { get; set; } = ""; [System.ComponentModel.DataAnnotations.Required] public string RequestJson { get; set; } = ""; }
}
