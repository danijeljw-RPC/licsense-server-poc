@page "/licenses/{LicenseId}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Permissions.LicensesRead)]
@inject AdminDataService Data
@inject LicenseStore Store
@inject ILicenseSigner Signer
@inject ILicenseKeyRing KeyRing
@inject DeploymentKeyService DeploymentKeys
@inject AuthenticationStateProvider AuthenticationState

<PageTitle>License @LicenseId</PageTitle>
@if (license is null)
{
    <div class="empty"><h1>License not found</h1><a href="/licenses">Back to licenses</a></div>
}
else
{
    <div class="page-heading">
        <div><p class="eyebrow">License record</p><h1>@license.LicenseId</h1><p>@license.Customer</p></div>
        <span class="status @license.Status">@license.Status</span>
    </div>
    @if (!string.IsNullOrWhiteSpace(DisplayMessage))
    {
        <div class="alert @DisplayMessageClass" role="status">@DisplayMessage
            @if (download is not null) { <text> Signed with key <code>@signedKeyId</code>.</text> <a download="@downloadName" href="@download">Download signed .license</a> }
        </div>
    }

    <div class="detail-grid">
        <article class="panel">
            <h2>Customer and entitlements</h2>
            <dl class="customer-details">
                <dt>Customer name</dt><dd>@license.Customer</dd>
                <dt>Current customer email</dt><dd>@license.CustomerEmail</dd>
                <dt>Signed contact snapshot</dt><dd>@license.SignedContactEmail</dd>
                <dt>Signed metadata visibility</dt><dd>This address is plaintext to anyone holding the signed license file.</dd>
            </dl>
            @foreach (var item in license.Entitlements)
            {
                <div class="entitlement"><div><strong>@item.Product</strong><span>@item.Edition · @item.LicenseType</span></div><div><strong>@item.Seats</strong><span>seats</span></div><div><strong>@(item.UpdatesUntil?.ToString("yyyy-MM-dd") ?? "—")</strong><span>updates until</span></div></div>
            }
        </article>
        <article class="panel">
            <h2>Lifecycle</h2>
            <dl><dt>Issued</dt><dd>@license.IssuedAt.ToString("u") UTC</dd><dt>Expires</dt><dd>@FormatExpiry(license.ExpiresAt)</dd><dt>Version</dt><dd>@license.Version</dd><dt>Cancelled</dt><dd>@(license.CancelledAt?.ToString("u") ?? "No")</dd><dt>Revoked</dt><dd>@(license.RevokedAt?.ToString("u") ?? "No")</dd><dt>Provenance</dt><dd>@(license.Provenance == "imported" ? "Imported (offline artifact)" : "Issued") @if (license.Provenance == "imported") { <span class="status imported">Imported</span> }</dd>@if (license.ImportedAt is not null) { <dt>Imported</dt><dd>@license.ImportedAt?.ToString("u") UTC</dd> }</dl>
            <p class="notice">Online checks observe lifecycle changes immediately. Previously downloaded offline files cannot be recalled or changed.</p>
        </article>
    </div>

    @if (!IsTerminal && !CanAmendTerms)
    {
        <p class="notice">This license's terms cannot be edited product-by-product through this page: it
            @(license.Entitlements.Count != 1 ? "has more than one product entitlement." : "was imported from a signed offline artifact, which remains the source of truth and would silently diverge from this relational index if amended here.")
            Use admin-side revoke to terminate it if needed.</p>
    }
    @if (!IsTerminal && CanAmendTerms)
    {
        <AuthorizeView Policy="@Permissions.LicensesUpdate">
            <Authorized>
                <h2 class="section-heading">Edit license terms</h2>
                <div class="terms-grid">
                    <article class="panel"><h2>Expiry</h2><p class="field-help">Current: @FormatExpiry(license.ExpiresAt)</p>
                        <form method="post" action="@($"/licenses/{Uri.EscapeDataString(LicenseId)}/terms")"><AntiforgeryToken /><input type="hidden" name="Version" value="@license.Version" />
                            <label>New expiry (UTC)<input type="datetime-local" name="ExpiresAt" required /></label><label>Reason (minimum 3 characters)<textarea name="Reason" minlength="3" maxlength="500" required></textarea></label><p class="notice">A past expiry blocks online checks immediately. Offline files cannot be recalled.</p><button class="button" type="submit">Update expiry</button>
                        </form>
                    </article>
                    <article class="panel"><h2>Seats</h2><p class="field-help">Current: @license.Entitlements.Single().Seats</p>
                        <form method="post" action="@($"/licenses/{Uri.EscapeDataString(LicenseId)}/terms")"><AntiforgeryToken /><input type="hidden" name="Version" value="@license.Version" />
                            <label>New seat count<input type="number" name="Seats" min="1" required /></label><label>Reason (minimum 3 characters)<textarea name="Reason" minlength="3" maxlength="500" required></textarea></label><button class="button" type="submit">Update seats</button>
                        </form>
                    </article>
                    <article class="panel"><h2>Updates until</h2><p class="field-help">Current: @(license.Entitlements.Single().UpdatesUntil?.ToString("yyyy-MM-dd") ?? "Not set")</p>
                        <form method="post" action="@($"/licenses/{Uri.EscapeDataString(LicenseId)}/terms")"><AntiforgeryToken /><input type="hidden" name="Version" value="@license.Version" />
                            <label>New updates-until date<input type="date" name="UpdatesUntil" required /></label><label>Reason (minimum 3 characters)<textarea name="Reason" minlength="3" maxlength="500" required></textarea></label><button class="button" type="submit">Update coverage</button>
                        </form>
                    </article>
                    <article class="panel"><h2>Edition</h2><p class="field-help">Current: @license.Entitlements.Single().Edition</p>
                        <form method="post" action="@($"/licenses/{Uri.EscapeDataString(LicenseId)}/terms")"><AntiforgeryToken /><input type="hidden" name="Version" value="@license.Version" />
                            <label>New edition<select name="Edition" required>@foreach (var edition in LicenseEditions.All) { <option value="@edition">@edition</option> }</select></label><label>Reason (minimum 3 characters)<textarea name="Reason" minlength="3" maxlength="500" required></textarea></label><button class="button" type="submit">Update edition</button>
                        </form>
                    </article>
                </div>
            </Authorized>
        </AuthorizeView>
    }

    <div class="split-grid operations">
        @if (!IsTerminal && license.IssuanceHistory.Count == 0)
        {
            <AuthorizeView Policy="@Permissions.LicensesCancel"><Authorized>
                <article class="panel danger-zone"><h2>Cancel never-activated license</h2><p>Cancellation is terminal and prevents future activation.</p>
                    <form method="post" action="@($"/licenses/{Uri.EscapeDataString(LicenseId)}/cancel")"><AntiforgeryToken /><input type="hidden" name="Version" value="@license.Version" /><label>Required reason<textarea name="Reason" minlength="3" maxlength="500" required></textarea></label><label class="confirm"><input type="checkbox" name="Confirmed" value="true" required /> I explicitly confirm cancellation.</label><p class="notice">Offline files cannot be recalled.</p><button class="button danger" type="submit">Confirm cancellation</button></form>
                </article>
            </Authorized></AuthorizeView>
        }
        else if (!IsTerminal)
        {
            <article class="panel"><h2>Cancellation unavailable</h2><p>This license has activation history and cannot be cancelled. Use revocation when access must be terminated.</p></article>
        }
        @if (!IsTerminal)
        {
            <AuthorizeView Policy="@Permissions.LicensesRevoke"><Authorized>
                <article class="panel danger-zone"><h2>Revoke license</h2><p>Revocation is terminal and immediately blocks activation, validation, and online refresh.</p>
                    <form method="post" action="@($"/licenses/{Uri.EscapeDataString(LicenseId)}/revoke")"><AntiforgeryToken /><input type="hidden" name="Version" value="@license.Version" /><label>Required reason<textarea name="Reason" minlength="3" maxlength="500" required></textarea></label><label class="confirm"><input type="checkbox" name="Confirmed" value="true" required /> I explicitly confirm revocation.</label><p class="notice">Previously downloaded offline files cannot be recalled.</p><button class="button danger" type="submit">Confirm revocation</button></form>
                </article>
            </Authorized></AuthorizeView>
        }
    </div>

    <article class="panel"><div class="panel-head"><div><p class="eyebrow">Seat usage</p><h2>Active activations</h2></div><strong>@license.ActiveSeatCount / @license.SeatLimit seats in use</strong></div>
        <dl class="seat-usage-summary">
            <dt>Configured seats</dt><dd>@license.SeatLimit</dd>
            <dt>Active activations</dt><dd>@license.ActiveSeatCount</dd>
            <dt>Available seats</dt><dd>@license.AvailableSeats</dd>
            <dt>Percentage used</dt><dd>@(license.SeatLimit > 0 ? $"{(double)license.ActiveSeatCount / license.SeatLimit:P0}" : "—")</dd>
            <dt>Historical (deactivated) activations</dt><dd>@license.HistoricalActivationCount</dd>
        </dl>
        @if (license.ActiveSeatsBySource.Count > 0)
        {
            <div class="table-wrap"><table><thead><tr><th>Source</th><th>Active seats</th></tr></thead><tbody>
                @foreach (var source in license.ActiveSeatsBySource) { <tr><td>@source.Source</td><td>@source.ActiveCount</td></tr> }
            </tbody></table></div>
        }
        @if (license.ActiveActivations.Count > 0)
        {
            @foreach (var active in license.ActiveActivations)
            {
                <div class="activation-card"><div><span>Mode</span><strong>@active.Mode</strong></div><div><span>Device</span><strong>…@active.DeviceSuffix</strong></div><div><span>Activated via</span><strong>@active.Source</strong></div><div><span>Activated</span><strong>@active.ActivatedAt.ToString("u") UTC</strong></div><div><span>Lease expires</span><strong>@(active.LeaseExpiresAt?.ToString("u") ?? "Offline")</strong></div></div>
                <AuthorizeView Policy="@Permissions.ActivationsManage"><Authorized><form method="post" action="@($"/licenses/{Uri.EscapeDataString(LicenseId)}/activations/{Uri.EscapeDataString(active.ActivationId)}/deactivate")"><AntiforgeryToken /><h2>Operator deactivation</h2><input type="hidden" name="Version" value="@license.Version" /><label>Required reason<textarea name="Reason" minlength="3" maxlength="500" required></textarea></label><label class="confirm"><input type="checkbox" name="Confirmed" value="true" required /> Confirm deactivation for …@active.DeviceSuffix.</label><button class="button danger" type="submit">Deactivate</button></form></Authorized></AuthorizeView>
            }
            <AuthorizeView Policy="@Permissions.ActivationsManage"><Authorized Context="refreshPermissionContext"><EditForm Model="credentials" FormName="refresh-lease" OnValidSubmit="RefreshAsync"><DataAnnotationsValidator /><h2>Refresh online lease</h2><label>Activation<InputSelect @bind-Value="credentials.ActivationId"><option value="">Select an active activation</option>@foreach (var active in license.ActiveActivations) { <option value="@active.ActivationId">@($"…{active.DeviceSuffix} · {active.Mode}")</option> }</InputSelect></label><label>Activation token<InputText type="password" @bind-Value="credentials.ActivationToken" autocomplete="off" /></label><label>Full device ID<InputText type="password" @bind-Value="credentials.DeviceId" autocomplete="off" /></label><label>Signing key<InputSelect @bind-Value="credentials.KeyId"><option value="">Default (@(KeyRing.DefaultKeyId ?? "none configured"))</option>@foreach (var key in KeyRing.Keys.Where(k => k.CanSign)) { <option value="@key.KeyId">@key.KeyId</option> }</InputSelect></label><button class="button secondary" type="submit" disabled="@(SelectedActivation?.Mode != "online")">Refresh and issue</button></EditForm></Authorized></AuthorizeView>
        }
        else { <p class="empty-inline">No active devices. This license has full seat capacity available.</p> }
    </article>

    <article class="panel"><div class="panel-head"><div><p class="eyebrow">Machine self-enrollment</p><h2>Deployment keys</h2></div></div>
        @if (!string.IsNullOrWhiteSpace(deploymentKeyMessage)) { <div class="alert @(deploymentKeyError ? "error" : "success")" role="status">@deploymentKeyMessage</div> }
        @if (revealedDeploymentKeySecret is not null) { <article class="panel"><h2>Copy this key now</h2><p>This value will not be shown again. Give it to the deployment tooling that will call <code>POST /api/v1/deployment-keys/enroll</code>.</p><input readonly value="@revealedDeploymentKeySecret" aria-label="New deployment key" /></article> }
        <AuthorizeView Policy="@Permissions.DeploymentKeysManage"><Authorized Context="deploymentKeyManageContext">
            @if (!IsTerminal)
            {
                <EditForm Model="createDeploymentKey" FormName="create-deployment-key" OnValidSubmit="CreateDeploymentKeyAsync"><DataAnnotationsValidator /><ValidationSummary />
                    <div class="form-grid"><label>Name<InputText @bind-Value="createDeploymentKey.Name" /></label><label>Expiry (UTC, optional)<InputDate Type="InputDateType.DateTimeLocal" @bind-Value="createDeploymentKey.ExpiresAt" /></label></div>
                    <button class="button" type="submit">Generate deployment key</button>
                </EditForm>
            }
        </Authorized></AuthorizeView>
        <AuthorizeView Policy="@Permissions.DeploymentKeysRead"><Authorized Context="deploymentKeyReadContext">
            @if (deploymentKeys.Count > 0)
            {
                <div class="table-wrap"><table><thead><tr><th>Name</th><th>Key</th><th>Created</th><th>Last used</th><th>Expiry</th><th>Status</th><th></th></tr></thead><tbody>
                    @foreach (var key in deploymentKeys)
                    {
                        <tr>
                            <td>@if (renamingId == key.Id) { <input @bind="renameValue" aria-label="New name" /> } else { @key.Name }</td>
                            <td><code>@key.PublicId…@key.LastFour</code></td>
                            <td>@key.CreatedAt.ToString("u")</td>
                            <td>@(key.LastUsedAt?.ToString("u") ?? "Never")</td>
                            <td>@(key.ExpiresAt?.ToString("u") ?? "No expiry")</td>
                            <td>@DeploymentKeyStatus(key)</td>
                            <td>
                                <AuthorizeView Policy="@Permissions.DeploymentKeysManage"><Authorized>
                                    @if (key.RevokedAt is null)
                                    {
                                        @if (renamingId == key.Id)
                                        {
                                            <button class="button secondary" type="button" @onclick="() => SaveRenameAsync(key)">Save</button>
                                            <button class="button secondary" type="button" @onclick="CancelRename">Cancel</button>
                                        }
                                        else
                                        {
                                            <button class="button secondary" type="button" @onclick="() => StartRename(key)">Rename</button>
                                            @if (!IsTerminal && DeploymentKeyStatus(key) == "Active")
                                            {
                                                <button class="button secondary" type="button" @onclick="() => RotateDeploymentKeyAsync(key)">Rotate</button>
                                            }
                                            <button class="button danger" type="button" @onclick="() => RevokeDeploymentKeyAsync(key)">Revoke</button>
                                        }
                                    }
                                </Authorized></AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody></table></div>
            }
            else { <p class="empty-inline">No deployment keys yet. Machines cannot self-enroll for this license until one is generated.</p> }
        </Authorized></AuthorizeView>
    </article>

    @if (!IsTerminal)
    {
        <AuthorizeView Policy="@Permissions.ActivationsManage"><Authorized Context="activationPermissionContext"><article class="panel"><h2>Activate for a device</h2><EditForm Model="activate" FormName="activate-license" OnValidSubmit="ActivateAsync"><DataAnnotationsValidator /><ValidationSummary /><label>Activation code<InputText type="password" @bind-Value="activate.ActivationCode" autocomplete="off" /></label><label>Client-generated activation token<InputText type="password" @bind-Value="activate.ActivationToken" autocomplete="off" /></label><label>Device ID (SHA-256)<InputText type="password" @bind-Value="activate.DeviceId" autocomplete="off" /></label><label>Device name<InputText @bind-Value="activate.DeviceName" /></label><label>Mode<InputSelect @bind-Value="activate.Mode"><option value="online">Online lease</option><option value="offline">Offline</option></InputSelect></label><label>Signing key<InputSelect @bind-Value="activate.KeyId"><option value="">Default (@(KeyRing.DefaultKeyId ?? "none configured"))</option>@foreach (var key in KeyRing.Keys.Where(k => k.CanSign)) { <option value="@key.KeyId">@key.KeyId</option> }</InputSelect></label><button class="button" type="submit">Activate and issue</button></EditForm></article></Authorized></AuthorizeView>
    }

    <article class="panel"><h2>Immutable history</h2><div class="table-wrap"><table><thead><tr><th>Time (UTC)</th><th>Action</th><th>Actor</th><th>Result</th><th>Old/new context</th></tr></thead><tbody>
        @if (license.History.Count == 0) { <tr><td colspan="5">No audit events recorded.</td></tr> }
        @foreach (var item in license.History) { <tr><td>@item.TimestampUtc.ToString("u")</td><td>@item.Action</td><td>@item.Actor</td><td>@item.Result</td><td><code class="context">@item.ContextJson</code></td></tr> }
    </tbody></table></div></article>
}

@code {
    [Parameter] public string LicenseId { get; set; } = "";
    [SupplyParameterFromQuery(Name = "notice")] public string? Notice { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    private LicenseDetailView? license;
    private readonly ActivateForm activate = new();
    private readonly CredentialForm credentials = new();
    private string? message; private string messageClass = "success"; private string? download; private string downloadName = "license.license"; private string? signedKeyId;
    private bool IsTerminal => license?.CancelledAt is not null || license?.RevokedAt is not null;
    private ActivationView? SelectedActivation => license?.ActiveActivations.FirstOrDefault(item => item.ActivationId == credentials.ActivationId)
        ?? license?.ActiveActivations.FirstOrDefault();
    // The signed artifact, not this relational index, is the source of truth for an imported
    // license (see LicenseStore.AmendTermsAsync's matching server-side check) - amending terms
    // here would silently diverge from it, even for the common single-product-import case.
    private bool CanAmendTerms => license?.Entitlements.Count == 1 && license.Provenance != LicenseProvenance.Imported;
    private string? DisplayMessage => Error ?? Notice ?? message;
    private string DisplayMessageClass => Error is not null ? "error" : Notice is not null ? "success" : messageClass;
    protected override async Task OnParametersSetAsync()
    {
        // Blazor reuses this component instance across client-side navigation between different
        // /licenses/{id} routes, so a secret revealed for one license would otherwise keep
        // rendering under the next license's panel - clear it (and any stale status message)
        // every time parameters are (re)bound, not just on first load.
        revealedDeploymentKeySecret = null;
        deploymentKeyMessage = null; deploymentKeyError = false;
        license = await Data.GetLicenseAsync(LicenseId);
        if (license is not null
            && !string.IsNullOrWhiteSpace(credentials.ActivationId)
            && license.ActiveActivations.All(item => item.ActivationId != credentials.ActivationId))
        {
            credentials.ActivationId = "";
        }
        await LoadDeploymentKeysAsync();
    }
    private IReadOnlyList<DeploymentKeyView> deploymentKeys = [];
    private readonly CreateDeploymentKeyForm createDeploymentKey = new();
    private string? deploymentKeyMessage; private bool deploymentKeyError; private string? revealedDeploymentKeySecret;
    private Guid? renamingId; private string renameValue = "";
    private async Task LoadDeploymentKeysAsync()
    {
        // Guarded like the AuthorizeView around the panel itself: a viewer without
        // deploymentKeys.read (e.g. License Issuer) must still be able to load the rest of the
        // page, so a permission failure here just leaves the list empty and hidden.
        try { var result = await DeploymentKeys.ListAsync(LicenseId); deploymentKeys = result.Success ? result.Value! : []; }
        catch (UnauthorizedAccessException) { deploymentKeys = []; }
    }
    // Renaming a deployment key changes the label shown on every activation card and in the
    // "active seats by source" table above, both computed from `license`, so it must be
    // refetched alongside the key list itself or a rename would look like it silently failed there.
    private async Task ReloadDeploymentKeysAndLicenseAsync()
    {
        await LoadDeploymentKeysAsync();
        license = await Data.GetLicenseAsync(LicenseId);
    }
    private async Task<string> ActorAsync() => (await AuthenticationState.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";
    private async Task CreateDeploymentKeyAsync()
    {
        revealedDeploymentKeySecret = null;
        var result = await DeploymentKeys.CreateAsync(LicenseId, new CreateDeploymentKeyRequest(createDeploymentKey.Name, createDeploymentKey.ExpiresAt), await ActorAsync());
        if (!result.Success) { deploymentKeyMessage = result.Error; deploymentKeyError = true; return; }
        revealedDeploymentKeySecret = result.Value!.Secret;
        deploymentKeyMessage = "Deployment key generated."; deploymentKeyError = false;
        createDeploymentKey.Name = ""; createDeploymentKey.ExpiresAt = null;
        await LoadDeploymentKeysAsync();
    }
    private void StartRename(DeploymentKeyView key) { renamingId = key.Id; renameValue = key.Name; }
    private void CancelRename() { renamingId = null; renameValue = ""; }
    private async Task SaveRenameAsync(DeploymentKeyView key)
    {
        var result = await DeploymentKeys.RenameAsync(key.Id, renameValue, await ActorAsync());
        if (!result.Success) { deploymentKeyMessage = result.Error; deploymentKeyError = true; return; }
        deploymentKeyMessage = "Deployment key renamed."; deploymentKeyError = false;
        renamingId = null;
        await ReloadDeploymentKeysAndLicenseAsync();
    }
    private async Task RotateDeploymentKeyAsync(DeploymentKeyView key)
    {
        revealedDeploymentKeySecret = null;
        var result = await DeploymentKeys.RotateAsync(key.Id, await ActorAsync());
        if (!result.Success) { deploymentKeyMessage = result.Error; deploymentKeyError = true; return; }
        revealedDeploymentKeySecret = result.Value!.Secret;
        deploymentKeyMessage = "Deployment key rotated. The old key is now revoked."; deploymentKeyError = false;
        await LoadDeploymentKeysAsync();
    }
    private async Task RevokeDeploymentKeyAsync(DeploymentKeyView key)
    {
        var result = await DeploymentKeys.RevokeAsync(key.Id, null, await ActorAsync());
        if (!result.Success) { deploymentKeyMessage = result.Error; deploymentKeyError = true; return; }
        // A just-created or just-rotated secret can still be on screen for this exact key when it
        // gets revoked without a page reload in between - that credential is now dead, so stop
        // telling the operator to copy it.
        revealedDeploymentKeySecret = null;
        deploymentKeyMessage = "Deployment key revoked."; deploymentKeyError = false;
        await LoadDeploymentKeysAsync();
    }
    private static string DeploymentKeyStatus(DeploymentKeyView key) =>
        key.RevokedAt is not null ? "Revoked"
        : key.ExpiresAt is not null && key.ExpiresAt <= DateTimeOffset.UtcNow ? "Expired"
        : "Active";
    private sealed class CreateDeploymentKeyForm
    {
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.StringLength(200)]
        public string Name { get; set; } = "";
        public DateTimeOffset? ExpiresAt { get; set; }
    }
    private static string FormatExpiry(DateTimeOffset? expiry) => expiry == LicenseTerms.PerpetualExpiry ? "Never (perpetual)" : expiry?.ToString("u") ?? "No expiry";
    private async Task ActivateAsync() { var request = new ActivateRequest(Guid.NewGuid().ToString(), activate.ActivationCode, activate.ActivationToken, activate.Mode, new DeviceRequest(SoftwareLicensing.DeviceIdentity.Scheme, activate.DeviceId, activate.DeviceName)); var result = await Store.ActivateAsync(LicenseId, request, DateTimeOffset.UtcNow, string.IsNullOrWhiteSpace(activate.KeyId) ? null : activate.KeyId); if (!result.Success) { message = result.Error; messageClass = "error"; return; } if (!await SetDownloadAsync(result.Value!, "Activation issued successfully.", activate.KeyId)) return; activate.ActivationCode = activate.ActivationToken = activate.DeviceId = ""; license = await Data.GetLicenseAsync(LicenseId); }
    private async Task RefreshAsync() { if (SelectedActivation is null || string.IsNullOrWhiteSpace(credentials.ActivationId)) return; var result = await Store.RefreshAsync(credentials.ActivationId, new ActivationCredentialRequest(credentials.ActivationToken, credentials.DeviceId), DateTimeOffset.UtcNow, string.IsNullOrWhiteSpace(credentials.KeyId) ? null : credentials.KeyId); if (!result.Success) { message = result.Error; messageClass = "error"; return; } if (!await SetDownloadAsync(result.Value!, "Online lease refreshed successfully.", credentials.KeyId)) return; credentials.ActivationId = credentials.ActivationToken = credentials.DeviceId = ""; license = await Data.GetLicenseAsync(LicenseId); }
    private async Task<bool> SetDownloadAsync(LicenseStore.ActiveActivation active, string success, string requestedKeyId) { var signing = Signer.Sign(await Store.CreateLicenseAsync(active, DateTimeOffset.UtcNow), string.IsNullOrWhiteSpace(requestedKeyId) ? null : requestedKeyId); if (!signing.Success) { message = signing.ErrorMessage; messageClass = "error"; return false; } var signed = signing.Envelope!.ToJsonString(new System.Text.Json.JsonSerializerOptions { WriteIndented = true }); signedKeyId = signing.Envelope!["keyId"]!.GetValue<string>(); downloadName = $"{LicenseId}-{active.ActivationId}.license"; download = $"data:application/octet-stream;base64,{Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(signed))}"; message = success; messageClass = "success"; return true; }
    private sealed class ActivateForm { [System.ComponentModel.DataAnnotations.Required] public string ActivationCode { get; set; } = ""; [System.ComponentModel.DataAnnotations.Required] public string ActivationToken { get; set; } = ""; [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.RegularExpression("^[A-Fa-f0-9]{64}$")] public string DeviceId { get; set; } = ""; [System.ComponentModel.DataAnnotations.StringLength(100)] public string? DeviceName { get; set; } public string Mode { get; set; } = "online"; public string KeyId { get; set; } = ""; }
    private sealed class CredentialForm { [System.ComponentModel.DataAnnotations.Required] public string ActivationId { get; set; } = ""; [System.ComponentModel.DataAnnotations.Required] public string ActivationToken { get; set; } = ""; [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.RegularExpression("^[A-Fa-f0-9]{64}$")] public string DeviceId { get; set; } = ""; public string KeyId { get; set; } = ""; }
}
