@page "/licenses/{LicenseId}"
@attribute [Authorize(Policy = "Administrator")]
@inject AdminDataService Data
@inject LicenseStore Store
@inject LicenseEnvelopeSigner Signer
@inject NavigationManager Navigation

<PageTitle>License @LicenseId</PageTitle>
@if (license is null) { <div class="empty"><h1>License not found</h1><a href="/licenses">Back to licenses</a></div> }
else
{
    <div class="page-heading"><div><p class="eyebrow">License record</p><h1>@license.LicenseId</h1><p>@license.Customer</p></div><span class="status @CurrentStatus">@CurrentStatus</span></div>
    @if (!string.IsNullOrWhiteSpace(message)) { <div class="alert @messageClass" role="status">@message @if (download is not null) { <a download="@downloadName" href="@download">Download signed .license</a> }</div> }
    <div class="detail-grid">
        <article class="panel"><h2>Entitlements</h2>@foreach (var item in license.Entitlements) { <div class="entitlement"><div><strong>@item.Product</strong><span>@item.Edition · @item.LicenseType</span></div><div><strong>@item.Seats</strong><span>seats</span></div><div><strong>@(item.UpdatesUntil?.ToString("yyyy-MM-dd") ?? "—")</strong><span>updates until</span></div></div> }</article>
        <article class="panel"><h2>Lifecycle</h2><dl><dt>Issued</dt><dd>@license.IssuedAt.ToString("u") UTC</dd><dt>Expires</dt><dd>@(license.ExpiresAt?.ToString("u") ?? "No expiry")</dd><dt>Revoked</dt><dd>@(license.RevokedAt?.ToString("u") ?? "No")</dd>@if (license.RevocationReason is not null) { <dt>Reason</dt><dd>@license.RevocationReason</dd> }</dl></article>
    </div>
    <article class="panel"><div class="panel-head"><div><p class="eyebrow">Current binding</p><h2>Activation</h2></div></div>
        @if (license.ActiveActivation is { } active) { <div class="activation-card"><div><span>Mode</span><strong>@active.Mode</strong></div><div><span>Device</span><strong>…@active.DeviceSuffix</strong></div><div><span>Activated</span><strong>@active.ActivatedAt.ToString("u") UTC</strong></div><div><span>Lease expires</span><strong>@(active.LeaseExpiresAt?.ToString("u") ?? "Offline")</strong></div></div><p class="notice">Transfer requires authenticated deactivation first. A second device is rejected while this activation remains active.</p><div class="split-grid operations"><EditForm Model="credentials" FormName="refresh-lease" OnValidSubmit="RefreshAsync" method="post"><DataAnnotationsValidator /><h2>Refresh online lease</h2><label>Activation token<InputText type="password" @bind-Value="credentials.ActivationToken" autocomplete="off" /></label><label>Full device ID<InputText type="password" @bind-Value="credentials.DeviceId" autocomplete="off" /></label><button class="button secondary" type="submit" disabled="@(active.Mode != "online")">Refresh and issue</button></EditForm><EditForm Model="credentials" FormName="deactivate-device" OnValidSubmit="DeactivateAsync" method="post"><DataAnnotationsValidator /><h2>Deactivate / transfer</h2><label>Activation token<InputText type="password" @bind-Value="credentials.ActivationToken" autocomplete="off" /></label><label>Full device ID<InputText type="password" @bind-Value="credentials.DeviceId" autocomplete="off" /></label><label class="confirm"><InputCheckbox @bind-Value="credentials.Confirmed" /> Confirm deactivation before transfer.</label><button class="button danger" type="submit" disabled="@(!credentials.Confirmed)">Deactivate</button></EditForm></div> }
        else { <p class="empty-inline">No active device. This license is available for activation or transfer.</p> }
    </article>
    @if (license.RevokedAt is null)
    {
        <div class="split-grid operations">
            <article class="panel"><h2>Activate for a device</h2><EditForm Model="activate" FormName="activate-license" OnValidSubmit="ActivateAsync" method="post"><DataAnnotationsValidator /><ValidationSummary /><label>Activation code<InputText type="password" @bind-Value="activate.ActivationCode" autocomplete="off" /></label><label>Client-generated activation token<InputText type="password" @bind-Value="activate.ActivationToken" autocomplete="off" /></label><label>Device ID (SHA-256)<InputText type="password" @bind-Value="activate.DeviceId" autocomplete="off" /></label><label>Device name<InputText @bind-Value="activate.DeviceName" /></label><label>Mode<InputSelect @bind-Value="activate.Mode"><option value="online">Online lease</option><option value="offline">Offline</option></InputSelect></label><button class="button" type="submit">Activate and issue</button></EditForm></article>
            <article class="panel danger-zone"><h2>Revoke license</h2><p>Revocation immediately blocks validation and online refresh. Offline files cannot be recalled until reconnect.</p><EditForm Model="revoke" FormName="revoke-license" OnValidSubmit="RevokeAsync" method="post"><DataAnnotationsValidator /><label>Required reason<InputTextArea @bind-Value="revoke.Reason" /></label><label class="confirm"><InputCheckbox @bind-Value="revoke.Confirmed" /> I understand this is destructive.</label><button class="button danger" type="submit" disabled="@(!revoke.Confirmed)">Confirm revocation</button></EditForm></article>
        </div>
    }
    <article class="panel"><h2>Issuance and activation history</h2><div class="table-wrap"><table><thead><tr><th>Activation</th><th>Mode</th><th>Device suffix</th><th>Activated (UTC)</th><th>Ended (UTC)</th></tr></thead><tbody>@foreach (var item in license.IssuanceHistory) { <tr><td>@item.ActivationId</td><td>@item.Mode</td><td>…@item.DeviceSuffix</td><td>@item.ActivatedAt.ToString("u")</td><td>@(item.DeactivatedAt?.ToString("u") ?? "Active")</td></tr> }</tbody></table></div></article>
}

@code {
    [Parameter] public string LicenseId { get; set; } = "";
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private LicenseDetailView? license; private readonly ActivateForm activate = new(); private readonly CredentialForm credentials = new(); private readonly RevokeForm revoke = new(); private string? message; private string messageClass = "success"; private string? download; private string downloadName = "license.license";
    private string CurrentStatus => license!.RevokedAt is not null ? "revoked" : license.ExpiresAt <= DateTimeOffset.UtcNow ? "expired" : license.ActiveActivation is not null ? "active" : "available";
    protected override async Task OnParametersSetAsync() => license = await Data.GetLicenseAsync(LicenseId);
    private async Task ActivateAsync() { var request = new ActivateRequest(Guid.NewGuid().ToString(), activate.ActivationCode, activate.ActivationToken, activate.Mode, new DeviceRequest(SoftwareLicensing.DeviceIdentity.Scheme, activate.DeviceId, activate.DeviceName)); var result = await Store.ActivateAsync(LicenseId, request, DateTimeOffset.UtcNow); if (!result.Success) { message = result.Error; messageClass = "error"; return; } await SetDownloadAsync(result.Value!, "Activation issued successfully."); activate.ActivationCode = activate.ActivationToken = activate.DeviceId = ""; license = await Data.GetLicenseAsync(LicenseId); }
    private async Task RefreshAsync() { if (license?.ActiveActivation is null) return; var result = await Store.RefreshAsync(license.ActiveActivation.ActivationId, new ActivationCredentialRequest(credentials.ActivationToken, credentials.DeviceId), DateTimeOffset.UtcNow); if (!result.Success) { message = result.Error; messageClass = "error"; return; } await SetDownloadAsync(result.Value!, "Online lease refreshed successfully."); credentials.ActivationToken = credentials.DeviceId = ""; license = await Data.GetLicenseAsync(LicenseId); }
    private async Task DeactivateAsync() { if (license?.ActiveActivation is null || !credentials.Confirmed) return; var result = await Store.DeactivateAsync(license.ActiveActivation.ActivationId, new ActivationCredentialRequest(credentials.ActivationToken, credentials.DeviceId), DateTimeOffset.UtcNow, HttpContext.User.Identity?.Name ?? "unknown"); message = result.Success ? "Activation deactivated. The license is now available for transfer." : result.Error; messageClass = result.Success ? "success" : "error"; credentials.ActivationToken = credentials.DeviceId = ""; credentials.Confirmed = false; download = null; license = await Data.GetLicenseAsync(LicenseId); }
    private async Task SetDownloadAsync(LicenseStore.ActiveActivation active, string success) { var signed = Signer.Sign(await Store.CreateLicenseAsync(active, DateTimeOffset.UtcNow)).ToJsonString(new System.Text.Json.JsonSerializerOptions { WriteIndented = true }); downloadName = $"{LicenseId}-{active.ActivationId}.license"; download = $"data:application/octet-stream;base64,{Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(signed))}"; message = success; messageClass = "success"; }
    private async Task RevokeAsync() { if (!revoke.Confirmed) return; var result = await Store.RevokeAsync(LicenseId, revoke.Reason, HttpContext.User.Identity?.Name ?? "unknown", DateTimeOffset.UtcNow); message = result.Success ? "License revoked." : result.Error; messageClass = result.Success ? "success" : "error"; license = await Data.GetLicenseAsync(LicenseId); }
    private sealed class ActivateForm { [System.ComponentModel.DataAnnotations.Required] public string ActivationCode { get; set; } = ""; [System.ComponentModel.DataAnnotations.Required] public string ActivationToken { get; set; } = ""; [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.RegularExpression("^[A-Fa-f0-9]{64}$")] public string DeviceId { get; set; } = ""; [System.ComponentModel.DataAnnotations.StringLength(100)] public string? DeviceName { get; set; } public string Mode { get; set; } = "online"; }
    private sealed class CredentialForm { [System.ComponentModel.DataAnnotations.Required] public string ActivationToken { get; set; } = ""; [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.RegularExpression("^[A-Fa-f0-9]{64}$")] public string DeviceId { get; set; } = ""; public bool Confirmed { get; set; } }
    private sealed class RevokeForm { [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.StringLength(500, MinimumLength = 3)] public string Reason { get; set; } = ""; public bool Confirmed { get; set; } }
}
