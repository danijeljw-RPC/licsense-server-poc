@page "/products"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "products.read")]
@inject ProductCatalogService Catalog
@inject AuthenticationStateProvider AuthenticationState

<PageTitle>Products</PageTitle>
<div class="page-heading"><div><p class="eyebrow">Catalog</p><h1>Products</h1><p>Manage stable product codes used for new license issuance.</p></div></div>

@if (message is not null) { <div class="alert @(isError ? "error" : "success")" role="status">@message</div> }

<form method="get" class="filters"><label>Search<input name="search" value="@Search" placeholder="Code or display name" /></label><button class="button secondary" type="submit">Search</button></form>

<AuthorizeView Policy="products.manage"><Authorized Context="createPermissionContext">
    <article class="panel form-panel"><h2>Add product</h2>
        <EditForm Model="create" FormName="create-product" OnValidSubmit="CreateAsync"><DataAnnotationsValidator /><ValidationSummary />
            <div class="form-grid"><label>Stable code<InputText @bind-Value="create.Code" /></label><label>Display name<InputText @bind-Value="create.DisplayName" /></label><label>Description<InputTextArea @bind-Value="create.Description" /></label></div>
            <button class="button" type="submit">Add product</button>
        </EditForm>
    </article>
</Authorized></AuthorizeView>

<div class="table-wrap"><table><thead><tr><th>Code</th><th>Name</th><th>Status</th><th>Licenses</th><th>Updated (UTC)</th><th></th></tr></thead><tbody>
@foreach (var product in products)
{
    <tr><td><code>@product.Code</code></td><td><strong>@product.DisplayName</strong><br />@product.Description</td><td>@(product.IsActive ? "Active" : "Archived")</td><td>@product.LicenseReferenceCount</td><td>@product.UpdatedAt.ToString("u")</td><td>
        <AuthorizeView Policy="products.manage"><Authorized Context="rowPermissionContext">
            <button class="button secondary" type="button" @onclick="() => Select(product)">Edit</button>
            <button class="button @(product.IsActive ? "danger" : "secondary")" type="button" @onclick="() => ToggleAsync(product)">@(product.IsActive ? "Archive" : "Activate")</button>
        </Authorized></AuthorizeView>
    </td></tr>
}
</tbody></table></div>

@if (selected is not null)
{
    <AuthorizeView Policy="products.manage"><Authorized Context="editPermissionContext">
        <article class="panel form-panel"><h2>Edit @selected.Code</h2><p>The stable code cannot be changed.</p>
            <EditForm Model="edit" FormName="edit-product" OnValidSubmit="UpdateAsync"><DataAnnotationsValidator /><ValidationSummary />
                <div class="form-grid"><label>Display name<InputText @bind-Value="edit.DisplayName" /></label><label>Description<InputTextArea @bind-Value="edit.Description" /></label></div>
                <button class="button" type="submit">Save product</button>
            </EditForm>
        </article>
    </Authorized></AuthorizeView>
}

@code {
    [SupplyParameterFromQuery] public string? Search { get; set; }
    private IReadOnlyList<ProductCatalogItem> products = [];
    private ProductCatalogItem? selected;
    private readonly ProductForm create = new();
    private readonly ProductForm edit = new();
    private string? message;
    private bool isError;

    protected override async Task OnParametersSetAsync() => products = await Catalog.SearchAsync(Search);

    private async Task<string> ActorAsync() =>
        (await AuthenticationState.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";

    private async Task CreateAsync() => await ExecuteAsync(async () =>
    {
        await Catalog.CreateAsync(create.Code, create.DisplayName, create.Description, await ActorAsync());
        create.Code = create.DisplayName = create.Description = "";
        message = "Product created.";
    });

    private void Select(ProductCatalogItem product)
    {
        selected = product;
        edit.DisplayName = product.DisplayName;
        edit.Description = product.Description ?? "";
    }

    private async Task UpdateAsync() => await ExecuteAsync(async () =>
    {
        if (selected is null) return;
        await Catalog.UpdateAsync(selected.Id, edit.DisplayName, edit.Description, await ActorAsync());
        message = "Product updated.";
    });

    private async Task ToggleAsync(ProductCatalogItem product) => await ExecuteAsync(async () =>
    {
        await Catalog.SetActiveAsync(product.Id, !product.IsActive, await ActorAsync());
        message = product.IsActive ? "Product archived." : "Product activated.";
    });

    private async Task ExecuteAsync(Func<Task> action)
    {
        message = null; isError = false;
        try { await action(); }
        catch (InvalidOperationException exception) { message = exception.Message; isError = true; }
        products = await Catalog.SearchAsync(Search);
    }

    private sealed class ProductForm
    {
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.StringLength(100)] public string Code { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.StringLength(200)] public string DisplayName { get; set; } = "";
        [System.ComponentModel.DataAnnotations.StringLength(2000)] public string Description { get; set; } = "";
    }
}
