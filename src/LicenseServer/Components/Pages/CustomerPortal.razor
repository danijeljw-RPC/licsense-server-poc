@page "/customer/portal"
@attribute [Authorize(Policy = "CustomerPortal")]
@using System.Security.Claims
@inject CustomerAccessService Access
@inject AuthenticationStateProvider Authentication

<PageTitle>My licenses</PageTitle>

<main aria-labelledby="customer-licenses-heading">
    <h1 id="customer-licenses-heading">My licenses</h1>
    <p>This portal is read-only. Contact support for device changes, email changes, or renewal updates.</p>
    @if (licenses is null) { <p role="status">Loading licenses…</p> }
    else if (licenses.Count == 0) { <p>No licenses are available for this customer.</p> }
    else
    {
        <div class="card-grid">
            @foreach (var license in licenses)
            {
                <article class="card">
                    <h2>@license.LicenseId</h2>
                    <dl>
                        <dt>Status</dt><dd>@license.Status</dd>
                        <dt>Product</dt><dd>@license.Product</dd>
                        <dt>Edition</dt><dd>@license.Edition</dd>
                        <dt>Seats</dt><dd>@license.Seats</dd>
                        <dt>Expiry</dt><dd>@(license.ExpiresAt?.ToString("yyyy-MM-dd") ?? "Never")</dd>
                        <dt>Activation</dt><dd>@license.ActivationStatus</dd>
                        @if (license.DeviceSuffix is not null) { <dt>Device</dt><dd>…@license.DeviceSuffix</dd> }
                    </dl>
                </article>
            }
        </div>
    }
    <form method="post" action="/customer/logout">
        <AntiforgeryToken />
        <button type="submit">Sign out</button>
    </form>
</main>

@code {
    private IReadOnlyList<CustomerLicenseView>? licenses;
    protected override async Task OnInitializedAsync()
    {
        var principal = (await Authentication.GetAuthenticationStateAsync()).User;
        if (Guid.TryParse(principal.FindFirstValue(ClaimTypes.NameIdentifier), out var customerId)
            && principal.HasClaim("session_kind", "customer"))
            licenses = await Access.GetLicensesAsync(customerId);
        else
            licenses = [];
    }
}
