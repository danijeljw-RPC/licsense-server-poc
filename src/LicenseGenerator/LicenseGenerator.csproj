<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifiers>osx-arm64;osx-x64;linux-x64;linux-arm64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Version is overridden by CI (-p:Version=X.Y.Z) at release build/pack time; this is only
         the local/dev fallback so an unversioned build still produces something sane. -->
    <Version>0.2.1</Version>
    <PackageId>LicenseGenerator</PackageId>
    <Authors>RePass Cloud Pty Ltd</Authors>
    <Company>RePass Cloud Pty Ltd</Company>
    <Copyright>Copyright 2026 Danijel-James Wynyard</Copyright>
    <Description>CLI tool for generating ECDSA-signed licence envelopes.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/repasscloud/license-server-app</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Licensing.Core\Licensing.Core.csproj" />
  </ItemGroup>

</Project>
